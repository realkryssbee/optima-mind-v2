{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; media-src 'self'; object-src 'none'; script-src 'self' https://plausible.io; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' https://plausible.io; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob: https://*.githubusercontent.com; font-src 'self' https://unpkg.com; connect-src 'self' https://api.github.com https://*.githubusercontent.com https://unpkg.com"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(fr|pl)/prise-de-rendez-vous(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: https://*.cal.com; media-src 'self'; object-src 'none'; script-src 'self' https://app.cal.com; style-src 'self' 'unsafe-inline' https://app.cal.com; font-src 'self'; connect-src 'self' https://app.cal.com; frame-src https://app.cal.com https://cal.com https://*.cal.com; upgrade-insecure-requests"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/sportifs(/.*)?",
      "destination": "/fr/sportifs$1",
      "statusCode": 301
    },
    {
      "source": "/entreprises(/.*)?",
      "destination": "/fr/entreprises$1",
      "statusCode": 301
    },
    {
      "source": "/a-propos(/.*)?",
      "destination": "/fr/a-propos$1",
      "statusCode": 301
    },
    {
      "source": "/contact(/.*)?",
      "destination": "/fr/contact$1",
      "statusCode": 301
    },
    {
      "source": "/mentions-legales(/.*)?",
      "destination": "/fr/mentions-legales$1",
      "statusCode": 301
    },
    {
      "source": "/prise-de-rendez-vous(/.*)?",
      "destination": "/fr/prise-de-rendez-vous$1",
      "statusCode": 301
    },
    {
      "source": "/reservation-recue(/.*)?",
      "destination": "/fr/prise-de-rendez-vous$1",
      "statusCode": 301
    },
    {
      "source": "/politique-de-confidentialite(/.*)?",
      "destination": "/fr/politique-de-confidentialite$1",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "p" }],
      "destination": "/fr/",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "page_id" }],
      "destination": "/fr/",
      "statusCode": 301
    },
    {
      "source": "/index.php(.*)",
      "destination": "/fr/",
      "statusCode": 301
    }
  ]
}
