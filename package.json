{
  "name": "optima-mind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "node scripts/static-server.mjs",
    "typecheck": "astro check",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:og-default": "node scripts/gen-og-default.mjs",
    "lhci:collect": "lhci collect --config=./lighthouserc.cjs",
    "lhci:assert": "lhci assert --config=./lighthouserc.cjs"
  },
  "dependencies": {
    "@astrojs/vercel": "^9.0.5",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "astro": "^5.18.2",
    "sharp": "^0.35.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
