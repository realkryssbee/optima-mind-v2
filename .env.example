# ============================================================
# Optima Mind — environment variables
# Copy to .env and fill. Never commit real secrets.
# ============================================================

# Site
PUBLIC_SITE_URL=https://www.optima-mind.com

# Analytics Plausible (sans cookie, respectueux RGPD) — optionnel
PUBLIC_ANALYTICS_DOMAIN=

# Contact form & newsletter (Brevo, EU data residency)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=info@optima-mind.com
BREVO_SENDER_NAME=Optima Mind
BREVO_LIST_ID=
CONTACT_RECIPIENT_EMAIL=info@optima-mind.com

# Rate limiting (Upstash Redis, EU region) — increment 5
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
