---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  intro?: string;
  /** Image de fond pleine largeur : le titre est superposé (voile sombre). */
  image?: ImageMetadata;
}

const { eyebrow, title, lead, intro, image } = Astro.props;
---

<section class="page-hero">
  {
    image && (
      <div class="page-hero__media" aria-hidden="true">
        <Image
          src={image}
          alt=""
          widths={[640, 1024, 1536, 1920]}
          sizes="100vw"
          format="avif"
          loading="eager"
          fetchpriority="high"
          class="page-hero__img"
        />
        <div class="page-hero__scrim"></div>
      </div>
    )
  }

  <div class="container page-hero__inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="page-hero__lead">{lead}</p>}
    {intro && <p class="page-hero__intro">{intro}</p>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    padding-block: clamp(3rem, 8vw, 5.5rem) var(--space-7);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .page-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .page-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Voile sombre (navy) : garantit le contraste du texte sur l'image (AA). */
  .page-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgb(23 32 44 / 0.82) 0%,
      rgb(23 32 44 / 0.55) 55%,
      rgb(23 32 44 / 0.3) 100%
    );
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-4);
    max-width: var(--container-narrow);
  }

  /* Texte clair uniquement quand une image de fond est présente
     (le voile sombre garantit alors le contraste AA). */
  .page-hero:has(.page-hero__media) .eyebrow {
    color: var(--color-bg);
  }

  .page-hero:has(.page-hero__media) h1 {
    color: var(--color-bg);
  }

  .page-hero:has(.page-hero__media) .page-hero__lead {
    font-size: var(--text-body-lg);
    color: rgb(255 255 255 / 0.92);
    font-weight: 600;
  }

  .page-hero:has(.page-hero__media) .page-hero__intro {
    color: rgb(255 255 255 / 0.88);
  }
</style>
