---
interface Props {
  title?: string;
  subtitle?: string;
  items: string[];
}

const { title, subtitle, items } = Astro.props;

/** Icônes thématiques (une par situation, dans l'ordre du CMS). */
const icons = [
  // Équilibre
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v18"/><path d="M5 7h14"/><path d="M5 7 3 11h4z"/><path d="M19 7l-2 4h4z"/><path d="M8 21h8"/></svg>`,
  // Doute / confiance
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9 10a3 3 0 0 1 6 0c0 2-3 2.5-3 4"/><circle cx="12" cy="17" r="0.6" fill="currentColor"/></svg>`,
  // Concentration / cible
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5.5"/><circle cx="12" cy="12" r="2"/></svg>`,
  // Émotions / cœur
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7-4.3-9.2-8.6C1.3 8.6 3 5.5 6.2 5.5c2 0 3.3 1.2 4 2.4h3.6c.7-1.2 2-2.4 4-2.4 3.2 0 4.9 3.1 3.4 5.9C19 15.7 12 20 12 20z"/></svg>`,
  // Rebond / résilience
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11c0-4 4-7 9-7s9 3 9 7"/><path d="M3 11v4a2 2 0 0 0 2 2h2"/><path d="M21 11v4a2 2 0 0 1-2 2h-2"/><path d="m7 21 4-4-4-4"/></svg>`,
  // Flèche / progression
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 17 10 11l4 4 6-7"/><path d="M15 8h5v5"/></svg>`,
  // Parole / communication
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-8 8H4l2-3"/><path d="M3 12a8 8 0 0 1 8-8h6l-2 3"/></svg>`,
  // Étoile / objectif
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.8-4.5 4.3 1.1 6.1L12 17l-5.4 2.8 1.1-6.1L3.2 9.4l6.1-.8z"/></svg>`,
];
const fallbackIcon = icons[icons.length - 1];
---

<section class="icon-list">
  <div class="container">
    {title && <h2 class="icon-list__title">{title}</h2>}
    {subtitle && <p class="icon-list__subtitle">{subtitle}</p>}
    <ul class="icon-list__items">
      {
        items.map((item, i) => (
          <li class="icon-list__item">
            <span class="icon-list__icon" aria-hidden="true" set:html={icons[i] ?? fallbackIcon} />
            <span class="icon-list__text">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .icon-list {
    padding-block: var(--section-y);
  }

  .icon-list__title {
    text-align: center;
  }

  .icon-list__subtitle {
    color: var(--color-ink-soft);
    margin: var(--space-2) auto var(--space-8);
    text-align: center;
    max-width: 45ch;
  }

  .icon-list__items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-5);
  }

  .icon-list__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--color-primary-soft) 0%, var(--color-surface) 7rem);
    box-shadow: var(--shadow-sm);
  }

  .icon-list__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    background-color: var(--color-cta);
    color: var(--color-cta-text);
    box-shadow: var(--shadow-sm);
  }

  .icon-list__icon :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }

  .icon-list__text {
    font-size: var(--text-body);
    line-height: 1.65;
    font-weight: 500;
    max-width: none;
  }
</style>
