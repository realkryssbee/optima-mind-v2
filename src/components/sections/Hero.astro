---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '../ui/Button.astro';

interface Cta {
  label: string;
  href: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  lead: string;
  ctas: Cta[];
  /** Phrase de proposition de valeur mise en avant. */
  valueProp?: string;
  /** Image de fond pleine largeur (accueil). */
  image?: ImageMetadata;
}

const { eyebrow, title, lead, ctas, valueProp, image } = Astro.props;
---

<section class="hero">
  {
    image && (
      <div class="hero__media" aria-hidden="true">
        <Image
          src={image}
          alt=""
          widths={[640, 1024, 1536, 1920]}
          sizes="100vw"
          format="avif"
          loading="eager"
          fetchpriority="high"
          class="hero__img"
        />
        <div class="hero__scrim"></div>
      </div>
    )
  }

  <div class="container hero__inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <p class="hero__lead">{lead}</p>
    <div class="hero__actions">
      {
        ctas.map((cta, i) => (
          <Button href={cta.href} size="lg" variant={i === 0 ? 'primary' : 'secondary'}>
            {cta.label}
          </Button>
        ))
      }
    </div>
    {valueProp && <p class="hero__value">{valueProp}</p>}
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: var(--section-y) calc(var(--section-y) * 0.75);
    background: var(--color-bg);
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Voile sombre : garantit le contraste du texte sur l'image (WCAG 2.2 AA).
     Dégradé plus marqué à gauche (zone de texte), plus léger à droite. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgb(10 28 38 / 0.8) 0%,
      rgb(10 28 38 / 0.55) 55%,
      rgb(10 28 38 / 0.3) 100%
    );
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-5);
    max-width: var(--container);
  }

  .hero .eyebrow {
    color: var(--color-bg);
  }

  .hero h1 {
    color: var(--color-bg);
  }

  .hero__lead {
    font-size: var(--text-body-lg);
    color: rgb(255 255 255 / 0.92);
    max-width: 45ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  .hero__value {
    margin-top: var(--space-6);
    padding-block-start: var(--space-6);
    border-top: 1px solid rgb(255 255 255 / 0.35);
    font-family: var(--font-hand);
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2rem);
    color: var(--color-bg);
    max-width: 30ch;
  }

  /* Sur image, le bouton secondaire (bordure primary) doit rester lisible :
     on lui donne un fond sombre translucide. */
  .hero :global(.button--secondary) {
    color: var(--color-bg);
    border-color: var(--color-bg);
    background-color: rgb(10 28 38 / 0.35);
  }

  .hero :global(.button--secondary:hover) {
    background-color: rgb(10 28 38 / 0.55);
    color: var(--color-bg);
  }
</style>
