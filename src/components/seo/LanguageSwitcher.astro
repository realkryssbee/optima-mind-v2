---
import { t, type Locale } from '../../lib/i18n';
import { withLocale } from '../../lib/locale';

interface Props {
  lang: Locale;
  /** Chemin de contenu sans préfixe de langue. */
  path: string;
}

const { lang, path } = Astro.props;
const locales: Locale[] = ['fr', 'pl'];
---

<div class="lang-switcher" data-lang-switcher>
  <button
    class="lang-switcher__trigger"
    type="button"
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls="lang-menu"
    aria-label={t(lang, 'lang.label')}
  >
    <svg
      class="lang-switcher__icon"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M2 12h20"></path>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span class="lang-switcher__code" lang={lang}>{lang.toUpperCase()}</span>
    <svg
      class="lang-switcher__chevron"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>

  <ul id="lang-menu" class="lang-switcher__menu" aria-label={t(lang, 'lang.label')}>
    {
      locales.map((code) => (
        <li>
          <a
            class="lang-switcher__link"
            href={withLocale(code, path)}
            lang={code}
            hreflang={code}
            aria-current={code === lang ? 'true' : undefined}
            data-lang-switch
            data-lang={code}
          >
            <span class="lang-switcher__link-name">
              {t(lang, code === 'fr' ? 'lang.fr' : 'lang.pl')}
            </span>
            <span class="lang-switcher__link-code" lang={code}>{code.toUpperCase()}</span>
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  // Mémorise la langue choisie (amélioration progressive : les liens
  // fonctionnent sans JavaScript). L'import force l'externalisation du
  // script (compatible CSP `script-src 'self'`).
  import { LANG_COOKIE } from '../../lib/locale';

  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((link) => {
    link.addEventListener('click', () => {
      const code = link.getAttribute('data-lang');
      if (code) {
        document.cookie = `${LANG_COOKIE}=${code}; path=/; max-age=31536000; samesite=lax`;
      }
    });
  });

  const root = document.querySelector<HTMLElement>('[data-lang-switcher]');
  if (root) {
    const trigger = root.querySelector<HTMLButtonElement>('.lang-switcher__trigger');
    const menu = root.querySelector<HTMLElement>('.lang-switcher__menu');

    const close = () => {
      if (!root) return;
      root.classList.remove('is-open');
      trigger?.setAttribute('aria-expanded', 'false');
    };

    trigger?.addEventListener('click', () => {
      const open = root.classList.toggle('is-open');
      trigger.setAttribute('aria-expanded', String(open));
    });

    // Fermeture : Échap, clic hors du menu, navigation vers une langue.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });

    document.addEventListener('click', (event) => {
      if (root && !root.contains(event.target as Node)) close();
    });
  }
</script>

<style>
  .lang-switcher {
    position: relative;
  }

  .lang-switcher__trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    min-width: var(--target-min);
    padding-inline: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-btn);
    background-color: var(--color-surface);
    color: var(--color-ink);
    font-weight: 700;
    font-size: var(--text-small);
    cursor: pointer;
    transition:
      border-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }

  .lang-switcher__trigger:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .lang-switcher__trigger[aria-expanded='true'] .lang-switcher__chevron {
    transform: rotate(180deg);
  }

  .lang-switcher__icon {
    color: var(--color-primary);
  }

  .lang-switcher__chevron {
    transition: transform var(--dur) var(--ease-out);
  }

  .lang-switcher__menu {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + var(--space-2));
    z-index: var(--z-modal);
    min-width: 12rem;
    margin: 0;
    padding: var(--space-2);
    list-style: none;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-btn);
    box-shadow: var(--shadow-lg);
    display: none;
  }

  .lang-switcher.is-open .lang-switcher__menu {
    display: block;
  }

  .lang-switcher__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--color-ink);
    font-weight: 600;
    min-height: 2.75rem;
  }

  .lang-switcher__link:hover {
    background-color: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .lang-switcher__link[aria-current='true'] {
    background-color: var(--color-primary);
    color: var(--color-bg);
  }

  .lang-switcher__link-code {
    font-size: var(--text-small);
    font-weight: 700;
    color: var(--color-ink-soft);
  }

  .lang-switcher__link[aria-current='true'] .lang-switcher__link-code {
    color: rgb(255 255 255 / 0.85);
  }

  /* Toutes les pages sont rendues avec ce composant : pas de cas mobile
     spécifique — le déclencheur compact (icône + code) tient partout. */
</style>
