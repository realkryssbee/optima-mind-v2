---
import { t, type Locale } from '../../lib/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<form
  class="newsletter"
  novalidate
  data-success={t(lang, 'newsletter.success')}
  data-error={t(lang, 'newsletter.error')}
  data-rate={t(lang, 'newsletter.rate')}
>
  <label class="newsletter__label" for="newsletter-email">
    {t(lang, 'newsletter.title')}
  </label>
  <input
    class="newsletter__input"
    id="newsletter-email"
    name="email"
    type="email"
    autocomplete="email"
    placeholder={t(lang, 'newsletter.placeholder')}
    required
    maxlength="200"
  />
  <label class="newsletter__consent">
    <input type="checkbox" name="consent" required />
    <span>{t(lang, 'newsletter.consent')}</span>
  </label>
  <input
    class="newsletter__honeypot"
    name="website"
    type="text"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />
  <button class="button button--primary newsletter__submit" type="submit">
    {t(lang, 'newsletter.submit')}
  </button>
  <p class="newsletter__status" role="status" aria-live="polite" hidden></p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('.newsletter');
  if (form) {
    const status = form.querySelector<HTMLElement>('.newsletter__status');
    const submit = form.querySelector<HTMLButtonElement>('.newsletter__submit');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      submit?.setAttribute('disabled', '');
      try {
        const body = new FormData(form);
        const res = await fetch('/api/newsletter/', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(body)),
        });
        if (res.ok && status) {
          status.textContent = form.dataset.success ?? 'Merci !';
          status.hidden = false;
          form.reset();
        } else if (res.status === 429 && status) {
          status.textContent = form.dataset.rate ?? 'Trop de demandes.';
          status.hidden = false;
        } else if (status) {
          status.textContent = form.dataset.error ?? 'Une erreur est survenue.';
          status.hidden = false;
        }
      } catch {
        if (status) {
          status.textContent = form.dataset.error ?? 'Une erreur est survenue.';
          status.hidden = false;
        }
      } finally {
        submit?.removeAttribute('disabled');
      }
    });
  }
</script>

<style>
  .newsletter {
    display: grid;
    gap: var(--space-3);
  }

  .newsletter__label {
    font-weight: 700;
  }

  .newsletter__input {
    min-height: var(--target-min);
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: var(--text-body);
  }

  .newsletter__consent {
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
    font-size: var(--text-small);
    color: var(--color-ink-soft);
  }

  .newsletter__consent input {
    margin-top: 0.2rem;
    min-width: 1.1rem;
    min-height: 1.1rem;
  }

  .newsletter__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .newsletter__status {
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-success);
  }
</style>
