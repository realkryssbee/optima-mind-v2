---
import Button from '../ui/Button.astro';
import { t, type Locale } from '../../lib/i18n';

interface Props {
  /** Id unique du champ (nom HTML). */
  id: string;
  /** Langue de l'interface du formulaire (FR/PL). */
  lang: Locale;
}

const { id, lang } = Astro.props;

const topics = [
  { value: 'sportif', label: t(lang, 'form.topic.sportif') },
  { value: 'equipe', label: t(lang, 'form.topic.equipe') },
  { value: 'entraineur', label: t(lang, 'form.topic.entraineur') },
  { value: 'entreprise', label: t(lang, 'form.topic.entreprise') },
] as const;
---

<form
  class="contact-form"
  method="post"
  action="/api/contact/"
  novalidate
  data-success={t(lang, 'form.status.success')}
  data-error={t(lang, 'form.status.error')}
  data-config={t(lang, 'form.status.config')}
  data-rate={t(lang, 'form.status.rate')}
>
  <div class="contact-form__grid">
    <div class="contact-form__field">
      <label class="contact-form__label" for={`${id}-firstname`}>
        {t(lang, 'form.firstname')}
        <span aria-hidden="true">*</span>
      </label>
      <input
        class="contact-form__input"
        id={`${id}-firstname`}
        name="firstname"
        type="text"
        autocomplete="given-name"
        required
        minlength="2"
        maxlength="100"
      />
    </div>

    <div class="contact-form__field">
      <label class="contact-form__label" for={`${id}-lastname`}>
        {t(lang, 'form.lastname')}
        <span aria-hidden="true">*</span>
      </label>
      <input
        class="contact-form__input"
        id={`${id}-lastname`}
        name="lastname"
        type="text"
        autocomplete="family-name"
        required
        minlength="2"
        maxlength="100"
      />
    </div>

    <div class="contact-form__field">
      <label class="contact-form__label" for={`${id}-email`}>
        {t(lang, 'form.email')}
        <span aria-hidden="true">*</span>
      </label>
      <input
        class="contact-form__input"
        id={`${id}-email`}
        name="email"
        type="email"
        autocomplete="email"
        required
        maxlength="200"
      />
    </div>

    <div class="contact-form__field">
      <label class="contact-form__label" for={`${id}-phone`}>{t(lang, 'form.phone')}</label>
      <input
        class="contact-form__input"
        id={`${id}-phone`}
        name="phone"
        type="tel"
        autocomplete="tel"
        maxlength="40"
      />
    </div>

    <div class="contact-form__field contact-form__field--full">
      <label class="contact-form__label" for={`${id}-topic`}>
        {t(lang, 'form.topic')}
        <span aria-hidden="true">*</span>
      </label>
      <select class="contact-form__input" id={`${id}-topic`} name="topic" required>
        <option value="" selected>
          {t(lang, 'form.select')}
        </option>
        {topics.map((t) => <option value={t.value}>{t.label}</option>)}
      </select>
    </div>

    <div class="contact-form__field contact-form__field--full">
      <label class="contact-form__label" for={`${id}-message`}>
        {t(lang, 'form.message')}
        <span aria-hidden="true">*</span>
      </label>
      <textarea
        class="contact-form__input contact-form__input--textarea"
        id={`${id}-message`}
        name="message"
        rows={6}
        required
        minlength="10"
        maxlength="3000"></textarea>
    </div>
  </div>

  <!-- Honeypot anti-spam (masqué visuellement, non focusable) -->
  <div class="contact-form__honeypot">
    <label for={`${id}-website`}>{t(lang, 'form.honeypot')}</label>
    <input id={`${id}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <p class="contact-form__status" role="status" aria-live="polite" hidden></p>

  <Button type="submit" variant="primary" class="contact-form__submit">
    {t(lang, 'form.submit')}
  </Button></form>

<script>
  const form = document.querySelector<HTMLFormElement>('.contact-form');
  if (form) {
    const status = form.querySelector<HTMLElement>('.contact-form__status');
    const submit = form.querySelector<HTMLButtonElement>('.contact-form__submit');

    const showStatus = (text: string) => {
      if (status) {
        status.textContent = text;
        status.hidden = false;
      }
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      submit?.setAttribute('disabled', '');
      submit?.setAttribute('aria-busy', 'true');
      try {
        const body = new FormData(form);
        const res = await fetch('/api/contact/', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(Object.fromEntries(body)),
        });
        if (res.ok) {
          showStatus(form.dataset.success ?? 'OK');
          form.reset();
        } else if (res.status === 429) {
          showStatus(form.dataset.rate ?? '');
        } else if (res.status === 503) {
          showStatus(form.dataset.config ?? '');
        } else {
          showStatus(form.dataset.error ?? '');
        }
      } catch {
        showStatus(form.dataset.error ?? '');
      } finally {
        submit?.removeAttribute('disabled');
        submit?.removeAttribute('aria-busy');
      }
    });
  }
</script>

<style>
  .contact-form__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .contact-form__field--full {
    grid-column: 1 / -1;
  }

  @media (max-width: 40rem) {
    .contact-form__grid {
      grid-template-columns: 1fr;
    }
  }

  .contact-form__label {
    display: block;
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .contact-form__input {
    width: 100%;
    min-height: var(--target-min);
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: var(--text-body);
    color: var(--color-ink);
    background-color: var(--color-bg);
  }

  .contact-form__input:focus-visible {
    border-color: var(--color-focus);
  }

  .contact-form__input--textarea {
    min-height: 8rem;
    resize: vertical;
  }

  .contact-form__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-form__status {
    margin-block: var(--space-5);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    font-weight: 600;
    background-color: var(--color-success-soft);
    color: var(--color-success);
  }

  .contact-form__submit {
    justify-self: start;
    margin-top: var(--space-5);
    padding-inline: 2.5rem;
  }

  @media (max-width: 40rem) {
    .contact-form__submit {
      width: 100%;
      justify-self: stretch;
    }
  }
</style>
