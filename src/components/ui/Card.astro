---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={`card${className ? ` ${className}` : ''}`}>
  <slot />
</div>

<style>
  .card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }
</style>
