---
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  ariaLabel?: string;
  class?: string;
  /** Lien externe : ouvre dans un nouvel onglet (rel="noopener noreferrer"). */
  external?: boolean;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  ariaLabel,
  class: className,
  external = false,
} = Astro.props;

const classes = `button button--${variant} button--${size}${className ? ` ${className}` : ''}`;
const extAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{
  href ? (
    <a href={href} class={classes} aria-label={ariaLabel} {...extAttrs}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} aria-label={ariaLabel}>
      <slot />
    </button>
  )
}

<style>
  /* Forme et gabarit inspirés du site actuel (boutons thegem, arrondis) :
     bouton principal cyan avec texte sombre (contraste AA vérifié). */
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: var(--target-min);
    padding: 0.95rem 1.9rem;
    border: 2px solid transparent;
    border-radius: var(--radius-pill);
    font-family: inherit;
    font-weight: 700;
    font-size: var(--text-body);
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out);
  }

  .button--primary {
    background-color: var(--color-cta);
    color: var(--color-cta-text);
  }

  .button--primary:hover {
    background-color: var(--color-cta-hover);
    color: var(--color-cta-text);
  }

  .button--primary:active {
    background-color: var(--color-cta-hover);
  }

  .button--secondary {
    background-color: transparent;
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .button--secondary:hover {
    background-color: var(--color-primary-soft);
    color: var(--color-primary-hover);
  }

  .button--ghost {
    background-color: transparent;
    color: var(--color-primary);
  }

  .button--ghost:hover {
    background-color: var(--color-primary-soft);
  }

  .button--lg {
    padding: 1.5rem 2.1rem;
    font-size: var(--text-body-lg);
  }
</style>
