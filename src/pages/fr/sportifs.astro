---
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Quote from '../../components/sections/Quote.astro';
import IconList from '../../components/sections/IconList.astro';
import Offers from '../../components/sections/Offers.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import FaqSection from '../../components/sections/FaqSection.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import sportifsBanner from '../../assets/uploads/banner-sportif-4.png';
import { getCollection } from 'astro:content';
import { getPageWithFallback, getSettings, getTestimonialsByAuthor } from '../../lib/content';
import { withLocale } from '../../lib/locale';
import { t, type Locale } from '../../lib/i18n';
import { SITE } from '../../lib/site';
import { breadcrumbJsonLd, faqPageJsonLd, reviewJsonLd, serviceJsonLd } from '../../lib/seo';

const lang = (Astro.currentLocale ?? 'fr') as Locale;
const path = '/sportifs/';
const { entry, usedFallback } = await getPageWithFallback(lang, 'sportifs');
const d = entry.data;
const settings = (await getSettings())?.data;
const canonicalHref = usedFallback ? `${SITE.domain}${withLocale('fr', path)}` : undefined;

const title = d.seo?.title ?? settings?.seoDefaults.title ?? 'Optima Mind';
const description = d.seo?.description ?? settings?.seoDefaults.description ?? '';
const ctas = [{ label: t(lang, 'cta.rdv'), href: `/${lang}/prise-de-rendez-vous/` }];

const testimonials = await getTestimonialsByAuthor(d.testimonials ?? [], lang);

// FAQ (catégorie sportifs) — affichée et balisée FAQPage seulement si
// des entrées existent dans le CMS.
const faqEntries = await getCollection('faq', (e) => {
  const entryId = e.id;
  return entryId.endsWith(`.${lang}.md`) && e.data.category === 'sportifs';
});
const faqItems = faqEntries.map((e) => ({ question: e.data.question, answer: e.data.answer }));

const services = (d.offers ?? []).map((offer, i) =>
  serviceJsonLd({
    id: `service-sport-${i + 1}`,
    name: offer.title,
    description: offer.intro,
  }),
);
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Accueil', href: `/${lang}/` },
    { name: 'Sportifs', href: path },
  ]),
  ...services,
  ...testimonials.map((t) => reviewJsonLd(t.data)),
  ...(faqItems.length > 0 ? [faqPageJsonLd(faqItems)] : []),
];
const ogImage = '/og/sportifs.png';
---

<PageLayout
  lang={lang}
  title={title}
  description={description}
  path={path}
  usedFallback={usedFallback}
  canonicalHref={canonicalHref}
  jsonLd={jsonLd}
  ogImage={ogImage}
>
  <PageHero eyebrow={d.hero?.eyebrow} title={d.title} lead={d.hero?.lead} />

  <figure class="banner">
    <Image
      src={sportifsBanner}
      alt=""
      widths={[480, 800, 1200, 1584]}
      sizes="100vw"
      format="avif"
      loading="lazy"
      class="banner__img"
    />
  </figure>

  {d.quote && <Quote text={d.quote.text} source={d.quote.source} />}

  {d.enjeux && <IconList title={d.enjeux.title} items={d.enjeux.items} />}

  {
    d.offers && d.offers.length > 0 && (
      <Offers title={t(lang, 'section.offers')} subLabel={t(lang, 'offers.sub')} items={d.offers} />
    )
  }

  {faqItems.length > 0 && <FaqSection title={t(lang, 'faq.title')} items={faqItems} />}

  {
    testimonials.length > 0 && (
      <Testimonials
        title={t(lang, 'section.testimonials')}
        items={testimonials.map((t) => ({
          quote: t.data.quote,
          author: t.data.author,
          role: t.data.role,
        }))}
      />
    )
  }

  {d.cta && <FinalCta title={d.cta.title ?? t(lang, 'cta.rdv')} lead={d.cta.lead} ctas={ctas} />}
</PageLayout>
