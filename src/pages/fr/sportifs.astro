---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Quote from '../../components/sections/Quote.astro';
import IconList from '../../components/sections/IconList.astro';
import Offers from '../../components/sections/Offers.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import { getPage, getSettings, getTestimonialsByAuthor } from '../../lib/content';

const lang = 'fr';
const path = '/sportifs/';
const usedFallback = (Astro.currentLocale ?? 'fr') !== lang;

const entry = await getPage(lang, 'sportifs');
if (!entry) throw new Error(`Contenu introuvable : sportifs.${lang}`);
const d = entry.data;
const settings = (await getSettings())?.data;

const title = d.seo?.title ?? settings?.seoDefaults.title ?? 'Optima Mind';
const description = d.seo?.description ?? settings?.seoDefaults.description ?? '';
const ctas = [{ label: 'Prendre RDV', href: `/${lang}/prise-de-rendez-vous/` }];

const testimonials = await getTestimonialsByAuthor(d.testimonials ?? [], lang);
---

<PageLayout
  lang={lang}
  title={title}
  description={description}
  path={path}
  usedFallback={usedFallback}
>
  <PageHero eyebrow={d.hero?.eyebrow} title={d.title} lead={d.hero?.lead} />

  {d.quote && <Quote text={d.quote.text} source={d.quote.source} />}

  {d.enjeux && <IconList title={d.enjeux.title} items={d.enjeux.items} />}

  {d.offers && d.offers.length > 0 && <Offers title="Les accompagnements" items={d.offers} />}

  {
    testimonials.length > 0 && (
      <Testimonials
        title="Témoignages"
        items={testimonials.map((t) => ({
          quote: t.data.quote,
          author: t.data.author,
          role: t.data.role,
        }))}
      />
    )
  }

  {d.cta && <FinalCta title={d.cta.title ?? 'Prendre RDV'} lead={d.cta.lead} ctas={ctas} />}
</PageLayout>
