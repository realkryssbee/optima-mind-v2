---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import { SITE } from '../../lib/site';

const lang = 'fr';
const path = '/mentions-legales/';
const usedFallback = (Astro.currentLocale ?? 'fr') !== lang;

const title = 'Mentions légales — Optima Mind';
const description =
  "Mentions légales du site Optima Mind : éditeur, statut, numéro d'entreprise, hébergement.";
---

<PageLayout
  lang={lang}
  title={title}
  description={description}
  path={path}
  usedFallback={usedFallback}
>
  <PageHero eyebrow="Informations légales" title="Mentions légales" />

  <article class="legal">
    <div class="container legal__inner">
      <section>
        <h2>Éditeur du site</h2>
        <dl>
          <dt>Nom / Dénomination</dt>
          <dd>{SITE.legalName}</dd>
          <dt>Statut juridique</dt>
          <dd>{SITE.legalStatus}</dd>
          <dt>Numéro d'entreprise (BCE)</dt>
          <dd>{SITE.bce}</dd>
          <dt>Adresse professionnelle</dt>
          <dd>
            {SITE.address.street}, {SITE.address.zip}
            {SITE.address.city} — {SITE.address.country}
          </dd>
          <dt>Contact</dt>
          <dd>
            Email : <a href={`mailto:${SITE.rgpdEmail}`}>{SITE.rgpdEmail}</a> · Site web :{' '}
            {SITE.domain.replace('https://', '')}
          </dd>
          <dt>Responsable de la publication</dt>
          <dd>Agnieszka Orchowska</dd>
        </dl>
      </section>

      <section>
        <h2>Hébergement</h2>
        <p>
          Le site est hébergé par Vercel Inc., 340 S. Lemon Ave #4133, Walnut, CA 91789, États-Unis
          (infrastructure mondiale, traitement des données conforme à la politique de
          confidentialité).
        </p>
      </section>

      <section>
        <h2>Propriété intellectuelle</h2>
        <p>
          L'ensemble des contenus du site (textes, images, logo, structure) est protégé par le droit
          d'auteur. Toute reproduction, représentation ou diffusion, totale ou partielle, sans
          autorisation préalable écrite de l'éditeur est interdite.
        </p>
      </section>

      <section>
        <h2>Limitation de responsabilité</h2>
        <p>
          Les contenus proposés sur ce site sont fournis à titre informatif. L'éditeur ne peut être
          tenu responsable d'éventuels dommages directs ou indirects résultant de l'utilisation des
          informations présentes. Les accompagnements proposés relèvent de la préparation mentale,
          du coaching et du développement personnel et professionnel. Ils ne se substituent en aucun
          cas à un suivi médical, psychologique ou psychiatrique.
        </p>
      </section>

      <section>
        <h2>Données personnelles</h2>
        <p>
          Le traitement des données personnelles est décrit dans la{' '}
          <a href={`/${lang}/politique-de-confidentialite/`}>politique de confidentialité</a>.
        </p>
      </section>
    </div>
  </article>
</PageLayout>

<style>
  .legal {
    padding-block: var(--section-y);
  }

  .legal__inner {
    display: grid;
    gap: var(--space-8);
    max-width: var(--container-narrow);
  }

  .legal__inner dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-5);
    margin: 0;
  }

  .legal__inner dt {
    font-weight: 700;
  }

  .legal__inner dd {
    margin: 0;
    color: var(--color-ink-soft);
  }
</style>
