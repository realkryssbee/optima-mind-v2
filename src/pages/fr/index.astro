---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import UniversCards from '../../components/sections/UniversCards.astro';
import AboutTeaser from '../../components/sections/AboutTeaser.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import References from '../../components/sections/References.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import { getPage, getSettings, getTestimonialsByAuthor } from '../../lib/content';
import { references } from '../../data/references';

const lang = 'fr';
const path = '/';
const usedFallback = (Astro.currentLocale ?? 'fr') !== lang;

const entry = await getPage(lang, 'home');
if (!entry) throw new Error(`Contenu introuvable : home.${lang}`);
const d = entry.data;
const settings = (await getSettings())?.data;

const title = d.seo?.title ?? settings?.seoDefaults.title ?? 'Optima Mind';
const description = d.seo?.description ?? settings?.seoDefaults.description ?? '';
const heroCtas = [
  { label: 'Prendre RDV', href: `/${lang}/prise-de-rendez-vous/` },
  { label: 'En savoir plus', href: `/${lang}/sportifs/` },
];
const aboutCtas = [
  { label: 'Découvrir mon parcours', href: `/${lang}/a-propos/` },
  { label: 'Contactez-nous', href: `/${lang}/contact/` },
];
const finalCtas = [{ label: 'Prendre RDV', href: `/${lang}/prise-de-rendez-vous/` }];

const featured = await getTestimonialsByAuthor(d.featuredTestimonials ?? [], lang);
---

<PageLayout
  lang={lang}
  title={title}
  description={description}
  path={path}
  usedFallback={usedFallback}
>
  <Hero
    eyebrow={d.hero?.eyebrow}
    title={d.title}
    lead={d.hero?.lead ?? ''}
    ctas={heroCtas}
    valueProp={d.valueProp}
  />

  <UniversCards title="Que proposons-nous ?" items={d.univers ?? []} />

  {
    d.aboutTeaser && (
      <AboutTeaser
        eyebrow={d.aboutTeaser.eyebrow}
        title={d.aboutTeaser.title}
        paragraphs={d.aboutTeaser.paragraphs}
        ctas={aboutCtas}
      />
    )
  }

  {
    featured.length > 0 && (
      <Testimonials
        title="Témoignages"
        items={featured.map((t) => ({
          quote: t.data.quote,
          author: t.data.author,
          role: t.data.role,
        }))}
      />
    )
  }

  {d.showReferences && <References title="Nos collaborations" items={references} />}

  {
    d.cta && (
      <FinalCta title={d.cta.title ?? 'Prendre rendez-vous'} lead={d.cta.lead} ctas={finalCtas} />
    )
  }
</PageLayout>
