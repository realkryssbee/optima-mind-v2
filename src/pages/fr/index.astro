---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import UniversCards from '../../components/sections/UniversCards.astro';
import AboutTeaser from '../../components/sections/AboutTeaser.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import References from '../../components/sections/References.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import heroImage from '../../assets/uploads/1_1-2_mini_mini1.jpg';
import { getPageWithFallback, getSettings, getTestimonialsByAuthor } from '../../lib/content';
import { references } from '../../data/references';
import { withLocale } from '../../lib/locale';
import { t, type Locale } from '../../lib/i18n';
import { SITE, SITE_FALLBACK } from '../../lib/site';
import { localBusinessJsonLd, reviewJsonLd, websiteJsonLd } from '../../lib/seo';

// Gabarit multilingue : sert le contenu de la langue courante (/fr/ ou /pl/),
// avec repli français si la traduction manque (brief §6).
const lang = (Astro.currentLocale ?? 'fr') as Locale;
const path = '/';
const { entry, usedFallback } = await getPageWithFallback(lang, 'home');
const d = entry.data;
const settings = (await getSettings())?.data;
const site = settings ?? SITE_FALLBACK;

// Fallback (/pl/ sans traduction) : le contenu est FR → canonical vers la
// version française.
const canonicalHref = usedFallback ? `${SITE.domain}${withLocale('fr', path)}` : undefined;

const title = d.seo?.title ?? settings?.seoDefaults.title ?? 'Optima Mind';
const description = d.seo?.description ?? settings?.seoDefaults.description ?? '';
const heroCtas = [
  { label: t(lang, 'cta.rdv'), href: `/${lang}/prise-de-rendez-vous/` },
  { label: t(lang, 'cta.learnMore'), href: `/${lang}/sportifs/` },
];
const aboutCtas = [
  { label: t(lang, 'cta.discover'), href: `/${lang}/a-propos/` },
  { label: t(lang, 'cta.contact'), href: `/${lang}/contact/` },
];
const finalCtas = [{ label: t(lang, 'cta.rdv'), href: `/${lang}/prise-de-rendez-vous/` }];

const featured = await getTestimonialsByAuthor(d.featuredTestimonials ?? [], lang);

const jsonLd = [
  localBusinessJsonLd(site),
  websiteJsonLd(site),
  ...featured.map((t) => reviewJsonLd(t.data)),
];
const ogImage = '/og/accueil.png';
---

<PageLayout
  lang={lang}
  title={title}
  description={description}
  path={path}
  usedFallback={usedFallback}
  canonicalHref={canonicalHref}
  jsonLd={jsonLd}
  ogImage={ogImage}
>
  <Hero
    eyebrow={d.hero?.eyebrow}
    title={d.title}
    lead={d.hero?.lead ?? ''}
    ctas={heroCtas}
    valueProp={d.valueProp}
    image={heroImage}
    scan={{
      label: t(lang, 'cta.scan'),
      sub: t(lang, 'cta.scan.sub'),
      href: 'https://optima.clixite-prod.cloud/',
    }}
  />

  <UniversCards title={t(lang, 'section.univers')} items={d.univers ?? []} />

  {
    d.aboutTeaser && (
      <AboutTeaser
        eyebrow={d.aboutTeaser.eyebrow}
        title={d.aboutTeaser.title}
        paragraphs={d.aboutTeaser.paragraphs}
        ctas={aboutCtas}
      />
    )
  }

  {
    featured.length > 0 && (
      <Testimonials
        title={t(lang, 'section.testimonials')}
        items={featured.map((t) => ({
          quote: t.data.quote,
          author: t.data.author,
          role: t.data.role,
        }))}
      />
    )
  }

  {d.showReferences && <References title={t(lang, 'section.references')} items={references} />}

  {
    d.cta && (
      <FinalCta title={d.cta.title ?? t(lang, 'cta.rdv')} lead={d.cta.lead} ctas={finalCtas} />
    )
  }
</PageLayout>
