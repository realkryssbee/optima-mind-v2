---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import UniversCards from '../../components/sections/UniversCards.astro';
import AboutTeaser from '../../components/sections/AboutTeaser.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import References from '../../components/sections/References.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import { home, references, testimonials } from '../../data/content-fr';

const lang = 'fr';
const path = '/';

// Contenu réel servi par fallback rewrite (brief §6) : la page est rendue
// sous /pl/ tant que la version polonaise n'existe pas.
const usedFallback = (Astro.currentLocale ?? 'fr') !== lang;

const title = 'Coach mental pour sportif et entreprises Wavre — Optima Mind';
const description =
  "Coach mental pour sportif et entreprises Wavre. La performance durable ne s'improvise pas, elle se construit. Préparation mentale à Wavre (Brabant wallon).";
---

<PageLayout
  lang={lang}
  title={title}
  description={description}
  path={path}
  usedFallback={usedFallback}
>
  <Hero
    eyebrow={home.hero.eyebrow}
    title={home.hero.title}
    lead={home.hero.lead}
    ctas={home.hero.ctas}
    valueProp={home.valueProp.title}
  />

  <UniversCards title="Que proposons-nous ?" items={home.univers} />

  <AboutTeaser
    eyebrow={home.aboutTeaser.eyebrow}
    title={home.aboutTeaser.title}
    paragraphs={home.aboutTeaser.paragraphs}
    ctas={home.aboutTeaser.ctas}
  />

  <Testimonials title="Témoignages" items={testimonials.filter((t) => t.featured)} />

  <References title="Nos collaborations" items={references} />

  <FinalCta title={home.finalCta.title} lead={home.finalCta.lead} ctas={home.finalCta.ctas} />
</PageLayout>
