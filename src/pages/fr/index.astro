---
import PageLayout from '../../layouts/PageLayout.astro';
import Button from '../../components/ui/Button.astro';
import { t } from '../../lib/i18n';
import { getRdvHref } from '../../data/nav';

const lang = 'fr';
const path = '/';

// Contenu réel servi par fallback rewrite (brief §6) : la page est
// rendue sous /pl/ tant que la version polonaise n'existe pas.
const usedFallback = (Astro.currentLocale ?? 'fr') !== lang;

const title = 'Coach mental pour sportif et entreprises Wavre — Optima Mind';
const description =
  "La performance durable ne s'improvise pas, elle se construit. Préparation mentale pour sportifs, entraîneurs et entreprises — Wavre, Brabant wallon.";
---

<PageLayout
  lang={lang}
  title={title}
  description={description}
  path={path}
  usedFallback={usedFallback}
>
  <section class="hero">
    <div class="container hero__inner">
      <p class="eyebrow">Optima Mind — Wavre, Belgique</p>
      <h1>Le coaching qui transforme votre potentiel</h1>
      <p class="hero__lead">
        La performance durable ne s'improvise pas, elle se construit. Une approche structurée,
        humaine et pragmatique au service des sportifs, des équipes, des entraîneurs et des
        entreprises.
      </p>
      <div class="hero__actions">
        <Button href={getRdvHref(lang)} size="lg">
          {t(lang, 'nav.rdv')}
        </Button>
        <Button href="/fr/sportifs/" variant="secondary" size="lg">
          Découvrir l'accompagnement
        </Button>
      </div>
      <p class="hero__note">
        ⟨À FOURNIR : photo d'Agnieszka (hero), accroche validée, sections univers / témoignages /
        références — incrément 2⟩
      </p>
    </div>
  </section>
</PageLayout>

<style>
  .hero {
    padding-block: var(--section-y);
    background:
      radial-gradient(60rem 30rem at 85% -10%, var(--color-primary-soft), transparent 60%),
      var(--color-bg);
  }

  .hero__inner {
    display: grid;
    gap: var(--space-5);
  }

  .hero__lead {
    font-size: var(--text-body-lg);
    color: var(--color-ink-soft);
    max-width: 45ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  .hero__note {
    font-size: var(--text-small);
    color: var(--color-muted);
  }
</style>
