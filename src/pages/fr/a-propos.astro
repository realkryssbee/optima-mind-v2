---
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import portrait from '../../assets/uploads/coach_01.jpg';
import { getPageWithFallback, getSettings } from '../../lib/content';
import { withLocale } from '../../lib/locale';
import { t, type Locale } from '../../lib/i18n';
import { SITE, SITE_FALLBACK } from '../../lib/site';
import { breadcrumbJsonLd, personJsonLd } from '../../lib/seo';

const lang = (Astro.currentLocale ?? 'fr') as Locale;
const path = '/a-propos/';
const { entry, usedFallback } = await getPageWithFallback(lang, 'apropos');
const d = entry.data;
const settings = (await getSettings())?.data;
const site = settings ?? SITE_FALLBACK;
const canonicalHref = usedFallback ? `${SITE.domain}${withLocale('fr', path)}` : undefined;

const title = d.seo?.title ?? settings?.seoDefaults.title ?? 'Optima Mind';
const description = d.seo?.description ?? settings?.seoDefaults.description ?? '';
const ctas = [
  { label: t(lang, 'cta.rdv'), href: `/${lang}/prise-de-rendez-vous/` },
  { label: t(lang, 'cta.contact'), href: `/${lang}/contact/` },
];

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Accueil', href: `/${lang}/` },
    { name: 'À propos', href: path },
  ]),
  personJsonLd(site),
];
const ogImage = '/og/apropos.png';
---

<PageLayout
  lang={lang}
  title={title}
  description={description}
  path={path}
  usedFallback={usedFallback}
  canonicalHref={canonicalHref}
  jsonLd={jsonLd}
  ogImage={ogImage}
>
  <PageHero eyebrow={d.hero?.eyebrow} title={d.title} />

  <div class="apropos">
    <div class="container apropos__grid">
      <div class="apropos__portrait">
        <Image
          src={portrait}
          alt="Accompagnement en préparation mentale — ⟨À FOURNIR : légende du visuel à confirmer⟩"
          widths={[320, 480, 640]}
          sizes="(max-width: 48rem) 100vw, 40vw"
          format="avif"
          loading="eager"
          class="apropos__portrait-img"
        />
      </div>
      <div class="apropos__sections">
        {
          (d.sections ?? []).map((section, i) => (
            <section class="apropos__section" aria-labelledby={`apropos-section-${i}`}>
              <h2 id={`apropos-section-${i}`}>{section.title}</h2>
              {section.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </section>
          ))
        }
      </div>
    </div>
  </div>

  {
    d.formations && (
      <section class="formations">
        <div class="container formations__inner">
          <h2>{d.formations.title}</h2>
          {d.formations.groups.map((group) => (
            <div class="formations__group">
              <h3>{group.name}</h3>
              <ul>
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    d.cta && (
      <FinalCta title={d.cta.title ?? t(lang, 'cta.contact')} lead={d.cta.lead} ctas={ctas} />
    )
  }
</PageLayout>

<style>
  .apropos {
    padding-block: var(--section-y);
  }

  .apropos__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-8);
    align-items: start;
  }

  .apropos__portrait {
    position: sticky;
    top: 6rem;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    background: linear-gradient(160deg, var(--color-primary-soft), var(--color-surface));
  }

  .apropos__portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .apropos__sections {
    display: grid;
    gap: var(--space-9);
  }

  .apropos__section {
    display: grid;
    gap: var(--space-4);
  }

  .formations {
    padding-block: var(--section-y);
    background-color: var(--color-bg-soft);
  }

  .formations__inner {
    display: grid;
    gap: var(--space-7);
    max-width: var(--container-narrow);
  }

  .formations__group {
    display: grid;
    gap: var(--space-3);
  }

  .formations__group h3 {
    color: var(--color-primary);
  }

  .formations__group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-2);
  }

  .formations__group li {
    padding-block-start: var(--space-2);
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 48rem) {
    .apropos__grid {
      grid-template-columns: 1fr;
    }

    .apropos__portrait {
      position: static;
      aspect-ratio: 4 / 3;
    }
  }
</style>
