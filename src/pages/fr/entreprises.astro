---
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import IconList from '../../components/sections/IconList.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import entreprisesHero from '../../assets/uploads/entreprises-hero-unsplash.jpg';
import entreprisesMission from '../../assets/uploads/entreprises-mission-unsplash.jpg';
import entreprisesBanner from '../../assets/uploads/entreprises-banner-unsplash.jpg';
import { getPageWithFallback, getSettings, getTestimonialsByAuthor } from '../../lib/content';
import { withLocale } from '../../lib/locale';
import { t, type Locale } from '../../lib/i18n';
import { SITE } from '../../lib/site';
import { breadcrumbJsonLd, reviewJsonLd, serviceJsonLd } from '../../lib/seo';

const lang = (Astro.currentLocale ?? 'fr') as Locale;
const path = '/entreprises/';
const { entry, usedFallback } = await getPageWithFallback(lang, 'entreprises');
const d = entry.data;
const settings = (await getSettings())?.data;
const canonicalHref = usedFallback ? `${SITE.domain}${withLocale('fr', path)}` : undefined;

const title = d.seo?.title ?? settings?.seoDefaults.title ?? 'Optima Mind';
const description = d.seo?.description ?? settings?.seoDefaults.description ?? '';
const ctas = [
  { label: t(lang, 'cta.contact'), href: `/${lang}/contact/` },
  { label: t(lang, 'cta.rdv'), href: `/${lang}/prise-de-rendez-vous/` },
];

// Témoignages d'entreprises (catégorie « entreprise ») — affichés dès que
// des entrées existent dans le CMS.
const testimonials = await getTestimonialsByAuthor(d.testimonials ?? [], lang);

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Accueil', href: `/${lang}/` },
    { name: 'Entreprises', href: path },
  ]),
  serviceJsonLd({
    id: 'service-entreprise',
    name: d.title,
    description: d.hero?.intro ?? d.hero?.lead ?? '',
  }),
  ...testimonials.map((t) => reviewJsonLd(t.data)),
];
const ogImage = '/og/entreprises.png';
---

<PageLayout
  lang={lang}
  title={title}
  description={description}
  path={path}
  usedFallback={usedFallback}
  canonicalHref={canonicalHref}
  jsonLd={jsonLd}
  ogImage={ogImage}
>
  <PageHero
    eyebrow={d.hero?.eyebrow}
    title={d.title}
    lead={d.hero?.lead}
    intro={d.hero?.intro}
    image={entreprisesHero}
  />

  {
    d.benefices && (
      <IconList
        title={d.benefices.title}
        subtitle={d.benefices.subtitle}
        items={d.benefices.items}
      />
    )
  }

  {
    d.mission && (
      <section class="mission">
        <div class="container mission__grid">
          <div class="mission__text">
            <p class="eyebrow">{d.mission.eyebrow}</p>
            <h2>{d.mission.title}</h2>
            {d.mission.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
          <figure class="mission__media">
            <Image
              src={entreprisesMission}
              alt=""
              widths={[480, 800, 1200]}
              sizes="(min-width: 60rem) 40vw, 100vw"
              format="avif"
              loading="lazy"
              class="mission__img"
            />
          </figure>
        </div>
      </section>
    )
  }

  {d.publicCible && <IconList title={d.publicCible.title} items={d.publicCible.items} />}

  {
    d.thematiques && (
      <IconList
        title={d.thematiques.title}
        subtitle={d.thematiques.subtitle}
        items={d.thematiques.items}
      />
    )
  }

  <figure class="bande">
    <Image
      src={entreprisesBanner}
      alt=""
      widths={[480, 800, 1200, 1920]}
      sizes="100vw"
      format="avif"
      loading="lazy"
      class="bande__img"
    />
  </figure>

  {
    testimonials.length > 0 && (
      <Testimonials
        title={t(lang, 'section.testimonials')}
        lang={lang}
        items={testimonials.map((t) => ({
          quote: t.data.quote,
          author: t.data.author,
          role: t.data.role,
        }))}
      />
    )
  }

  {
    d.cta && (
      <FinalCta title={d.cta.title ?? t(lang, 'cta.contact')} lead={d.cta.lead} ctas={ctas} />
    )
  }
</PageLayout>

<style>
  .mission {
    padding-block: var(--section-y);
    background-color: var(--color-bg-soft);
  }

  .mission__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: var(--space-9);
    align-items: center;
  }

  .mission__text {
    display: grid;
    gap: var(--space-4);
  }

  .mission__text p:not(.eyebrow) {
    color: var(--color-ink-soft);
  }

  .mission__media {
    margin: 0;
  }

  .mission__img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 48rem) {
    .mission__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Bandeau image pleine largeur (respiration visuelle). */
  .bande {
    margin: 0;
  }

  .bande__img {
    width: 100%;
    height: auto;
    max-height: 26rem;
    object-fit: cover;
  }
</style>
