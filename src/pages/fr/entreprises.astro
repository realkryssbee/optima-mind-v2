---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import IconList from '../../components/sections/IconList.astro';
import Testimonials from '../../components/sections/Testimonials.astro';
import FinalCta from '../../components/sections/FinalCta.astro';
import { getPage, getSettings, getTestimonialsByAuthor } from '../../lib/content';
import { withLocale } from '../../lib/locale';
import { SITE } from '../../lib/site';
import { breadcrumbJsonLd, reviewJsonLd, serviceJsonLd } from '../../lib/seo';

const lang = 'fr';
const path = '/entreprises/';
const usedFallback = (Astro.currentLocale ?? 'fr') !== lang;
const canonicalHref = usedFallback ? `${SITE.domain}${withLocale('fr', path)}` : undefined;

const entry = await getPage(lang, 'entreprises');
if (!entry) throw new Error(`Contenu introuvable : entreprises.${lang}`);
const d = entry.data;
const settings = (await getSettings())?.data;

const title = d.seo?.title ?? settings?.seoDefaults.title ?? 'Optima Mind';
const description = d.seo?.description ?? settings?.seoDefaults.description ?? '';
const ctas = [
  { label: 'Contactez-nous', href: `/${lang}/contact/` },
  { label: 'Prendre RDV', href: `/${lang}/prise-de-rendez-vous/` },
];

// Témoignages d'entreprises (catégorie « entreprise ») — affichés dès que
// des entrées existent dans le CMS.
const testimonials = await getTestimonialsByAuthor(d.testimonials ?? [], lang);

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Accueil', href: `/${lang}/` },
    { name: 'Entreprises', href: path },
  ]),
  serviceJsonLd({
    id: 'service-entreprise',
    name: d.title,
    description: d.hero?.intro ?? d.hero?.lead ?? '',
  }),
  ...testimonials.map((t) => reviewJsonLd(t.data)),
];
const ogImage = '/og/entreprises.png';
---

<PageLayout
  lang={lang}
  title={title}
  description={description}
  path={path}
  usedFallback={usedFallback}
  canonicalHref={canonicalHref}
  jsonLd={jsonLd}
  ogImage={ogImage}
>
  <PageHero eyebrow={d.hero?.eyebrow} title={d.title} lead={d.hero?.lead} intro={d.hero?.intro} />

  {
    d.benefices && (
      <IconList
        title={d.benefices.title}
        subtitle={d.benefices.subtitle}
        items={d.benefices.items}
      />
    )
  }

  {
    d.mission && (
      <section class="mission">
        <div class="container mission__inner">
          <p class="eyebrow">{d.mission.eyebrow}</p>
          <h2>{d.mission.title}</h2>
          {d.mission.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
        </div>
      </section>
    )
  }

  {d.publicCible && <IconList title={d.publicCible.title} items={d.publicCible.items} />}

  {
    d.thematiques && (
      <IconList
        title={d.thematiques.title}
        subtitle={d.thematiques.subtitle}
        items={d.thematiques.items}
      />
    )
  }

  {
    testimonials.length > 0 && (
      <Testimonials
        title="Témoignages"
        items={testimonials.map((t) => ({
          quote: t.data.quote,
          author: t.data.author,
          role: t.data.role,
        }))}
      />
    )
  }

  {d.cta && <FinalCta title={d.cta.title ?? 'Contactez-nous'} lead={d.cta.lead} ctas={ctas} />}
</PageLayout>

<style>
  .mission {
    padding-block: var(--section-y);
    background-color: var(--color-bg-soft);
  }

  .mission__inner {
    display: grid;
    gap: var(--space-4);
    max-width: var(--container-narrow);
  }

  .mission__inner p:not(.eyebrow) {
    color: var(--color-ink-soft);
  }
</style>
