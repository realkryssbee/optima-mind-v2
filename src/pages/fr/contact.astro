---
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ContactForm from '../../components/forms/ContactForm.astro';
import contactBanner from '../../assets/uploads/banner-contacte-moi_2.png';
import { getPageWithFallback, getSettings } from '../../lib/content';
import { SITE, SITE_FALLBACK, telHref } from '../../lib/site';
import { withLocale } from '../../lib/locale';
import { t, type Locale } from '../../lib/i18n';
import { breadcrumbJsonLd } from '../../lib/seo';

const lang = (Astro.currentLocale ?? 'fr') as Locale;
const path = '/contact/';
const { entry, usedFallback } = await getPageWithFallback(lang, 'contact');
const d = entry.data;
const settings = (await getSettings())?.data ?? SITE_FALLBACK;
const canonicalHref = usedFallback ? `${SITE.domain}${withLocale('fr', path)}` : undefined;

const title = d.seo?.title ?? 'Contact — Optima Mind';
const description = d.seo?.description ?? '';

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Accueil', href: `/${lang}/` },
    { name: 'Contact', href: path },
  ]),
];
const ogImage = '/og/contact.png';

const mapsUrl =
  'https://www.google.com/maps/search/?api=1&query=' +
  encodeURIComponent(
    `${settings.address.street}, ${settings.address.zip} ${settings.address.city}`,
  );

/** Localise les libellés des lieux de séance (réglages non traduits). */
function localizeLieu(locale: Locale, name: string): string {
  if (name.includes('Kampus')) return t(locale, 'lieu.kampus');
  if (name.includes('domicile')) return t(locale, 'lieu.domicile');
  return name;
}
---

<PageLayout
  lang={lang}
  title={title}
  description={description}
  path={path}
  usedFallback={usedFallback}
  canonicalHref={canonicalHref}
  jsonLd={jsonLd}
  ogImage={ogImage}
>
  <PageHero eyebrow={d.hero?.eyebrow} title={d.title} />

  <figure class="banner">
    <Image
      src={contactBanner}
      alt=""
      widths={[480, 800, 1200, 1600, 2000]}
      sizes="100vw"
      format="avif"
      loading="lazy"
      class="banner__img"
    />
  </figure>

  <div class="contact">
    <div class="container contact__grid">
      <ContactForm id="contact" lang={lang} />

      <aside class="contact__info">
        <h2>{t(lang, 'contact.coords')}</h2>

        <div class="contact__block">
          <h3>{t(lang, 'contact.address')}</h3>
          <address class="contact__address">
            <p>{settings.name}</p>
            <p>
              {settings.address.street}
              <br />
              {settings.address.zip}
              {settings.address.city}, {settings.address.country}
            </p>
            <p>
              <a href={mapsUrl} target="_blank" rel="noopener noreferrer">
                {t(lang, 'contact.map')}
              </a>
            </p>
          </address>
        </div>

        <div class="contact__block">
          <h3>{t(lang, 'contact.phoneEmail')}</h3>
          <p>
            <a href={telHref(settings.phone)}>{settings.phone}</a>
          </p>
          <p>
            <a href={`mailto:${settings.email}`}>{settings.email}</a>
          </p>
        </div>

        <div class="contact__block">
          <h3>{t(lang, 'contact.hours')}</h3>
          <p>{settings.openingHours}</p>
        </div>

        <div class="contact__block">
          <h3>{t(lang, 'contact.venues')}</h3>
          <p>{t(lang, 'contact.modes')}</p>
          <ul class="contact__lieux">
            {
              (settings.lieux ?? []).map((lieu) => (
                <li>
                  {localizeLieu(lang, lieu.name)} — {lieu.address}
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </div>
</PageLayout>

<style>
  .contact {
    padding-block: var(--section-y);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr);
    gap: var(--space-9);
    align-items: start;
  }

  .contact__info {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg-soft);
  }

  .contact__block h3 {
    font-size: var(--text-h4);
    margin-bottom: var(--space-2);
  }

  .contact__address {
    font-style: normal;
    display: grid;
    gap: var(--space-2);
  }

  .contact__lieux {
    margin: 0;
    padding-inline-start: var(--space-5);
    display: grid;
    gap: var(--space-2);
  }

  @media (max-width: 48rem) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
