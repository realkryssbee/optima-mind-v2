---
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ContactForm from '../../components/forms/ContactForm.astro';
import contactBanner from '../../assets/uploads/banner-contacte-moi_2.png';
import { getPage, getSettings } from '../../lib/content';
import { SITE, SITE_FALLBACK, telHref } from '../../lib/site';
import { withLocale } from '../../lib/locale';
import { breadcrumbJsonLd } from '../../lib/seo';

const lang = 'fr';
const path = '/contact/';
const usedFallback = (Astro.currentLocale ?? 'fr') !== lang;
const canonicalHref = usedFallback ? `${SITE.domain}${withLocale('fr', path)}` : undefined;

const entry = await getPage(lang, 'contact');
if (!entry) throw new Error(`Contenu introuvable : contact.${lang}`);
const d = entry.data;
const settings = (await getSettings())?.data ?? SITE_FALLBACK;

const title = d.seo?.title ?? 'Contact — Optima Mind';
const description = d.seo?.description ?? '';

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Accueil', href: `/${lang}/` },
    { name: 'Contact', href: path },
  ]),
];
const ogImage = '/og/contact.png';

const mapsUrl =
  'https://www.google.com/maps/search/?api=1&query=' +
  encodeURIComponent(
    `${settings.address.street}, ${settings.address.zip} ${settings.address.city}`,
  );
---

<PageLayout
  lang={lang}
  title={title}
  description={description}
  path={path}
  usedFallback={usedFallback}
  canonicalHref={canonicalHref}
  jsonLd={jsonLd}
  ogImage={ogImage}
>
  <PageHero eyebrow={d.hero?.eyebrow} title={d.title} />

  <figure class="banner">
    <Image
      src={contactBanner}
      alt=""
      widths={[480, 800, 1200, 1600, 2000]}
      sizes="100vw"
      format="avif"
      loading="lazy"
      class="banner__img"
    />
  </figure>

  <div class="contact">
    <div class="container contact__grid">
      <ContactForm id="contact" />

      <aside class="contact__info">
        <h2>Coordonnées</h2>

        <div class="contact__block">
          <h3>Adresse</h3>
          <address class="contact__address">
            <p>{settings.name}</p>
            <p>
              {settings.address.street}
              <br />
              {settings.address.zip}
              {settings.address.city}, {settings.address.country}
            </p>
            <p>
              <a href={mapsUrl} target="_blank" rel="noopener noreferrer"> Voir sur la carte </a>
            </p>
          </address>
        </div>

        <div class="contact__block">
          <h3>Téléphone & email</h3>
          <p>
            <a href={telHref(settings.phone)}>{settings.phone}</a>
          </p>
          <p>
            <a href={`mailto:${settings.email}`}>{settings.email}</a>
          </p>
        </div>

        <div class="contact__block">
          <h3>Horaires</h3>
          <p>{settings.openingHours}</p>
        </div>

        <div class="contact__block">
          <h3>Lieux de séance</h3>
          <p>En visioconférence ou en présentiel :</p>
          <ul class="contact__lieux">
            {
              (settings.lieux ?? []).map((lieu) => (
                <li>
                  {lieu.name} — {lieu.address}
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </div>
</PageLayout>

<style>
  .contact {
    padding-block: var(--section-y);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.6fr);
    gap: var(--space-9);
    align-items: start;
  }

  .contact__info {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg-soft);
  }

  .contact__block h3 {
    font-size: var(--text-h4);
    margin-bottom: var(--space-2);
  }

  .contact__address {
    font-style: normal;
    display: grid;
    gap: var(--space-2);
  }

  .contact__lieux {
    margin: 0;
    padding-inline-start: var(--space-5);
    display: grid;
    gap: var(--space-2);
  }

  @media (max-width: 48rem) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
