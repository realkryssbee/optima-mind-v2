---
import PageLayout from '../../../layouts/PageLayout.astro';
import PageHero from '../../../components/sections/PageHero.astro';
import { getCollection } from 'astro:content';
import { t } from '../../../lib/i18n';
import { breadcrumbJsonLd } from '../../../lib/seo';

const lang = 'fr';
const path = '/blog/';
const usedFallback = (Astro.currentLocale ?? 'fr') !== lang;

// Blog : hors périmètre v1, mais les routes et le modèle existent (§5.4).
const posts = (
  await getCollection('blog', (e) => e.id.endsWith(`.${lang}.md`) && !e.data.draft)
).sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt));

const title = t(lang, 'blog.meta.title');
const description = t(lang, 'blog.meta.description');
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Accueil', href: `/${lang}/` },
    { name: 'Blog', href: path },
  ]),
];
const ogImage = '/og-default.png';

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString('fr-BE', { day: 'numeric', month: 'long', year: 'numeric' });
---

<PageLayout
  lang={lang}
  title={title}
  description={description}
  path={path}
  usedFallback={usedFallback}
  jsonLd={jsonLd}
  ogImage={ogImage}
>
  <PageHero eyebrow="Blog" title="Blog" />

  <section class="blog">
    <div class="container">
      {
        posts.length === 0 ? (
          <p class="blog__empty">{t(lang, 'blog.empty')}</p>
        ) : (
          <ul class="blog__list">
            {posts.map((post) => (
              <li class="blog__item">
                <a class="blog__link" href={`/${lang}/blog/${post.data.slug}/`}>
                  <h2>{post.data.title}</h2>
                  {post.data.excerpt && <p class="blog__excerpt">{post.data.excerpt}</p>}
                  <time datetime={post.data.publishedAt}>{formatDate(post.data.publishedAt)}</time>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</PageLayout>

<style>
  .blog {
    padding-block: var(--section-y);
  }

  .blog__empty {
    color: var(--color-ink-soft);
    font-size: var(--text-body-lg);
  }

  .blog__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-5);
  }

  .blog__link {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: var(--color-ink);
  }

  .blog__link:hover {
    border-color: var(--color-primary);
  }

  .blog__excerpt {
    color: var(--color-ink-soft);
  }

  .blog__link time {
    color: var(--color-muted);
    font-size: var(--text-small);
  }
</style>
