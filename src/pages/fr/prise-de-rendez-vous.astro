---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Button from '../../components/ui/Button.astro';
import CalEmbed from '../../components/booking/CalEmbed.astro';
import { getPageWithFallback, getSettings } from '../../lib/content';
import { SITE, SITE_FALLBACK } from '../../lib/site';
import { withLocale } from '../../lib/locale';
import { t, type Locale } from '../../lib/i18n';
import { breadcrumbJsonLd } from '../../lib/seo';

const lang = (Astro.currentLocale ?? 'fr') as Locale;
const path = '/prise-de-rendez-vous/';
const { entry, usedFallback } = await getPageWithFallback(lang, 'rdv');
const d = entry.data;
const settings = (await getSettings())?.data ?? SITE_FALLBACK;
const canonicalHref = usedFallback ? `${SITE.domain}${withLocale('fr', path)}` : undefined;

const title = d.seo?.title ?? 'Prendre rendez-vous — Optima Mind';
const description = d.seo?.description ?? '';

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Accueil', href: `/${lang}/` },
    { name: t(lang, 'nav.rdv'), href: path },
  ]),
];
const ogImage = '/og/prise-de-rendez-vous.png';

const types = [
  { name: t(lang, 'rdv.type.sportif'), duration: '60 min', href: `/${lang}/sportifs/` },
  { name: t(lang, 'rdv.type.equipe'), duration: '90 min', href: `/${lang}/sportifs/` },
  { name: t(lang, 'rdv.type.entraineur'), duration: '60 min', href: `/${lang}/sportifs/` },
  { name: t(lang, 'rdv.type.entreprise'), duration: '90 min', href: `/${lang}/entreprises/` },
] as const;

/** Localise les libellés des lieux de séance (réglages non traduits). */
function localizeLieu(locale: Locale, name: string): string {
  if (name.includes('Kampus')) return t(locale, 'lieu.kampus');
  if (name.includes('domicile')) return t(locale, 'lieu.domicile');
  return name;
}
---

<PageLayout
  lang={lang}
  title={title}
  description={description}
  path={path}
  usedFallback={usedFallback}
  canonicalHref={canonicalHref}
  jsonLd={jsonLd}
  ogImage={ogImage}
>
  <PageHero eyebrow={d.hero?.eyebrow} title={d.title} lead={d.hero?.lead} />

  <section class="rdv">
    <div class="container rdv__inner">
      <div class="rdv__booking">
        <h2>{t(lang, 'rdv.online')}</h2>
        {
          settings.booking.calUrl ? (
            <CalEmbed calUrl={settings.booking.calUrl} locale={lang} />
          ) : (
            <>
              <p>{settings.booking.note || '⟨À FOURNIR : lien Cal.com⟩'}</p>
              <div class="rdv__actions">
                <Button href={`/${lang}/contact/`}>{t(lang, 'cta.contact')}</Button>
                <Button href={`mailto:${settings.email}`} variant="secondary">
                  {settings.email}
                </Button>
              </div>
            </>
          )
        }
      </div>

      <div class="rdv__types">
        <h2>{t(lang, 'rdv.types')}</h2>
        <p class="rdv__types-sub">{t(lang, 'rdv.duration.note')}</p>
        <ul class="rdv__types-list">
          {
            types.map((type) => (
              <li class="rdv__type">
                <span class="rdv__type-name">{type.name}</span>
                <span class="rdv__type-duration">{type.duration}</span>
                <a class="rdv__type-link" href={type.href}>
                  {t(lang, 'cta.learnMore')}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="rdv__lieux">
        <h2>{t(lang, 'rdv.lieux')}</h2>
        <ul class="rdv__lieux-list">
          {
            (settings.lieux ?? []).map((lieu) => (
              <li class="rdv__lieu">
                <h3>{localizeLieu(lang, lieu.name)}</h3>
                <p>{lieu.address}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .rdv {
    padding-block: var(--section-y);
  }

  .rdv__inner {
    display: grid;
    gap: var(--space-9);
  }

  .rdv__booking,
  .rdv__types,
  .rdv__lieux {
    display: grid;
    gap: var(--space-4);
  }

  .rdv__booking {
    padding: var(--space-7);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, var(--color-primary-soft), var(--color-surface) 60%);
  }

  .rdv__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .rdv__types-list,
  .rdv__lieux-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-5);
  }

  .rdv__type {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
  }

  .rdv__type-name {
    font-weight: 700;
  }

  .rdv__type-duration {
    color: var(--color-ink-soft);
    font-size: var(--text-small);
  }

  .rdv__type-link {
    margin-top: var(--space-2);
  }

  .rdv__lieu h3 {
    font-size: var(--text-h4);
  }

  .rdv__lieu p {
    color: var(--color-ink-soft);
  }
</style>
