---
import { render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import { getPageWithFallback, getSettings } from '../../lib/content';
import { withLocale } from '../../lib/locale';
import { t, type Locale } from '../../lib/i18n';
import { SITE } from '../../lib/site';
import { breadcrumbJsonLd } from '../../lib/seo';

const lang = (Astro.currentLocale ?? 'fr') as Locale;
const path = '/politique-de-confidentialite/';
const { entry, usedFallback } = await getPageWithFallback(lang, 'privacy');
const d = entry.data;
const { Content } = await render(entry);
const settings = (await getSettings())?.data;
const canonicalHref = usedFallback ? `${SITE.domain}${withLocale('fr', path)}` : undefined;

const title = d.seo?.title ?? 'Politique de confidentialité — Optima Mind';
const description = d.seo?.description ?? settings?.seoDefaults.description ?? '';

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Accueil', href: `/${lang}/` },
    { name: t(lang, 'footer.privacy'), href: path },
  ]),
];
const ogImage = '/og/politique-de-confidentialite.png';
---

<PageLayout
  lang={lang}
  title={title}
  description={description}
  path={path}
  usedFallback={usedFallback}
  canonicalHref={canonicalHref}
  jsonLd={jsonLd}
  ogImage={ogImage}
>
  <PageHero eyebrow={d.hero?.eyebrow} title={d.title} />

  <article class="legal">
    <div class="container legal__inner">
      <Content />
    </div>
  </article>
</PageLayout>

<style>
  .legal {
    padding-block: var(--section-y);
  }

  .legal__inner {
    max-width: var(--container-narrow);
    display: grid;
    gap: var(--space-5);
  }

  .legal__inner h2 {
    font-size: var(--text-h3);
    margin-top: var(--space-6);
  }

  .legal__inner h2:first-child {
    margin-top: 0;
  }

  .legal__inner p,
  .legal__inner li {
    color: var(--color-ink-soft);
  }

  .legal__inner ul {
    padding-inline-start: var(--space-5);
    display: grid;
    gap: var(--space-2);
  }

  .legal__inner strong {
    color: var(--color-ink);
  }
</style>
